{
  "name": "atlas-foncier",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && esbuild server/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "clean": "rm -rf client/dist dist build node_modules",
    "postinstall": "npm run typegen",
    "prebuild": "npm run sync",
    "predev": "npm run sync",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Atlas Foncier - potentiel foncier et energetique des batiments parisiens",
  "dependencies": {
    "@databricks/appkit": "0.57.0",
    "@databricks/appkit-ui": "0.57.0",
    "@databricks/sdk-experimental": "0.17.0",
    "@deck.gl/core": "^9.1.4",
    "@deck.gl/geo-layers": "^9.1.4",
    "@deck.gl/layers": "^9.1.4",
    "@deck.gl/react": "^9.1.4",
    "@types/leaflet": "^1.9.22",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "0.546.0",
    "maplibre-gl": "^4.7.1",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.18.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.6.2",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^6.2.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.9"
  }
}
